# fish: fisher owns installed plugin files; git tracks only the manifest (fish_plugins).
# functions/, completions/ and conf.d/ are ignored wholesale — to track a file of our
# own there, add a !-negation line for it below.
home/.config/fish/fish_variables
home/.config/fish/functions/*
!home/.config/fish/functions/take.fish
home/.config/fish/completions/*
home/.config/fish/conf.d/*
!home/.config/fish/conf.d/myabbrs.fish
!home/.config/fish/conf.d/mise-activate.fish

# mise: global tools differ per machine; install with `mise use -g`.
home/.config/mise/

# herdr: only config.toml is ours; the rest is runtime state (logs, sockets, session).
home/.config/herdr/*
!home/.config/herdr/config.toml

# fresh: only config.json is ours; tsconfig.json and types/ are generated for init.ts.
home/.config/fresh/*
!home/.config/fresh/config.json
